# Public browser application configuration. Add the production domain to the
# Neon Auth trusted-domain list. Google client credentials stay in Neon Auth,
# not in this application environment.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
NEXT_PUBLIC_NEON_DATA_API_URL=

# Administrator-only hosted execution values. Configure these in Vercel, never
# in NEXT_PUBLIC_* variables or browser storage.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
DATABASE_URL=

# Vercel server-only Neon Auth verification values. Copy these from the same
# production Neon branch used by NEXT_PUBLIC_NEON_AUTH_URL.
NEON_AUTH_JWKS_URL=
# Match the signed Google member JWT's exact iss claim. Do not infer this from
# an anonymous token or append the Auth API path: their issuers can differ.
NEON_AUTH_ISSUER=
