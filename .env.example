# Public browser application configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_NEON_AUTH_URL=
NEXT_PUBLIC_NEON_DATA_API_URL=

# Administrator-only hosted execution values. Configure these in Vercel, never
# in NEXT_PUBLIC_* variables or browser storage.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_DAILY_RUN_LIMIT=5
DATABASE_URL=

# Vercel server-only Neon Auth verification values.
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
